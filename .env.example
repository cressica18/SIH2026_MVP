# Vasundhara SIH 2026 MVP - Environment Variables
# Copy this file to .env and fill in your values

# Google Gemini API Key (for AI features like quality assessment, price recommendation)
GEMINI_API_KEY=your_gemini_api_key_here

# Application URL (used for API endpoints and redirects)
APP_URL=http://localhost:3000

# Server port
PORT=3000
