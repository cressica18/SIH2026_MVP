{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist-server",
    "allowImportingTsExtensions": true,
    "paths": {
      "@shared/*": ["./src/*"]
    }
  },
  "include": ["server/src/**/*"],
  "exclude": ["node_modules", "dist-server"]
}
